# Bu örnekte gerçek anahtar bulunmaz. Supabase standart anahtarları otomatik sağlar.
TRANSCRIPTION_PROVIDER=fake
TRANSCRIPTION_MODEL=fake-v1
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# CX-008 başlangıç değeri: Europe/Istanbul takvim ayı başına 15 dakika.
FREE_QUOTA_SECONDS=900
# Canlıda ayrı rastgele >=32 karakter secret; bu örnek değeri canlıda kullanma.
FREE_QUOTA_PEPPER=local-test-only-not-a-production-secret-000000
